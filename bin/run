#!/bin/sh
# What every tool in this directory runs through. It builds where a source,
# the pom or a 68000 source is newer than the last build, or a core is not
# assembled, then runs the class it is handed on its command line.
# doc/tools.md.
set -e
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
classes=$root/target/classes
built=$classes/.built
# A tool is asked for any of the four cores and for the stub, so all five
# are looked for.
missing=
for core in YMXR_sndh.bin YMXR_sndh-perf.bin YMXR_sndh-lean.bin YMXR_sndh-perf-lean.bin \
            YMXR_prg.bin; do
    [ -f "$classes/org/ymxr/68k/$core" ] || missing=1
done
if [ ! -f "$built" ] || [ -n "$missing" ] || [ -n "$(find "$root/src/main/java" "$root/pom.xml" "$root"/68k/*.S -newer "$built" -print -quit 2>/dev/null)" ]; then
    # The build reads standard input, which for a filter has the file
    # to convert, so it reads none.
    (cd "$root" && mvn -q process-classes dependency:build-classpath \
        -Dmdep.outputFile=target/classpath </dev/null >/dev/null)
    : > "$built"
fi
class=$1
shift
exec java -ea -cp "$classes:$(cat "$root/target/classpath")" "$class" "$@"
