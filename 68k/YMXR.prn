  694  00000A34  00000000             @ ymxr_tick3_cell:   dc.l    0                       
  695                                   
  696                                   ; The offsets the patching writes at, measured off the first handler's
  697                                   ; own labels: the row it writes, the marker it reads, and its loop cell.
  698                                   ; A monitor's mark stands between those blocks, and the distances follow
  699                                   ; it. Every handler is laid out by the one macro, so one handler's
  700                                   ; offsets are all four handlers'. The rig reads them back.
  701           =00000003               TICK_SEL        equ     ymxr_tick0_row-ymxr_tick0+3   ; the target register
  702           =00000008               TICK_PTR        equ     ymxr_tick0_row-ymxr_tick0+8   ; the place: a tick's row
  703           =00000016               TICK_STEP       equ     ymxr_tick0_row-ymxr_tick0+22  ; the place's own address
  704           =00000024               TICK_LOOPT      equ     ymxr_tick0_mark-ymxr_tick0+2  ; the loop cell's address
  705           =0000002C               TICK_LOOPR      equ     ymxr_tick0_mark-ymxr_tick0+10 ; the same
  706           =00000030               TICK_LOOPW      equ     ymxr_tick0_mark-ymxr_tick0+14 ; the place's address
  707           =0000004A               TICK_CELL       equ     ymxr_tick0_cell-ymxr_tick0    ; row RR, or 0 once
  708                                   
  709                                   ; A parked place: a marker with no loop cell, so a stray tick stops its
  710                                   ; timer.
  711  00000A38  80                     ymxr_park:      dc.b    $80
  712  00000A39  00                                     .even


