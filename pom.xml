<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.ymx</groupId>
    <artifactId>ymxr</artifactId>
    <version>0.3.21</version>

    <properties>
        <maven.compiler.source>23</maven.compiler.source>
        <maven.compiler.target>23</maven.compiler.target>
        <maven.compiler.release>23</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The assembler that builds the SNDH core and the program stub
             the tools combine with bound tunes. Nothing else in the build
             runs it. -->
        <rmac>rmac</rmac>
        <jspecify.version>1.0.0</jspecify.version>
        <errorprone.version>2.36.0</errorprone.version>
        <nullaway.version>0.12.3</nullaway.version>
        <!-- Every package is null-marked and enforced. -->
        <nullaway.packages>org.ymxr,org.ymxs</nullaway.packages>
        <nullaway.severity>ERROR</nullaway.severity>
        <!-- CLI arguments for exec:exec@ym-to-ymxr (-Dargs="..."). -->
        <args></args>
    </properties>

    <dependencies>
        <dependency>
            <!-- the tables a tune is made of, and the 68000 reader images
                 a tool binds them with (doc/BINARIES.md 1) -->
            <groupId>org.dtx</groupId>
            <artifactId>dtx</artifactId>
            <version>0.11.6</version>
        </dependency>
        <dependency>
            <!-- the tune data structure every conversion here passes
                 through, and its JSON form (doc/ymxs.md) -->
            <groupId>org.ymx</groupId>
            <artifactId>ymxs</artifactId>
            <version>0.3.5</version>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <fork>true</fork>
                    <compilerArgs>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>-Xmaxwarns</arg>
                        <arg>100000</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:${nullaway.severity} -XepOpt:NullAway:AnnotatedPackages=${nullaway.packages} -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:AssertsEnabled=true</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${errorprone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <!-- The converter, runnable from Maven in a forked JVM:
                       mvn -q compile exec:exec@ym-to-ymxr -Dargs="in.ym out.ymxr" -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>ym-to-ymxr</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <commandlineArgs>-ea -cp %classpath org.ymxr.YmToYmxr ${args}</commandlineArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- The SNDH core and the program stub, assembled
                             from 68k/ into the classes the jar is made of
                             and into go/binaries/data, which go:embed reads
                             (doc/BINARIES.md). This is the one step rmac is
                             needed for: name another with -Drmac=PATH. -->
                        <id>binaries</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <commandlineArgs>-ea -cp %classpath org.ymxr.Binaries "${project.build.outputDirectory}/org/ymxr/68k" "${project.basedir}/go/binaries/data" "-a${rmac}" "-s${project.basedir}/68k"</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
